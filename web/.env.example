# Where the Spring API lives. Vite only exposes variables prefixed VITE_ to the
# browser, which is the guard that keeps a server secret from being bundled by
# accident.
#
# Unset is fine for local development: the client falls back to
# http://localhost:8080, which is where `./mvnw spring-boot:run` serves. A
# deployment must set this, and the API must list this app's origin in
# invoicely.security.allowed-origins or the browser will block every call.
VITE_API_BASE_URL=http://localhost:8080
